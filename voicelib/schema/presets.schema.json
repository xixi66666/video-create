{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "voicelib/schema/presets.schema.json",
  "title": "Voice Presets",
  "description": "角色预设表:情绪 × 语速 × 停顿。库内使用具名情绪键,避免供应商的定序向量写错位。",
  "type": "object",
  "additionalProperties": false,
  "required": ["character_id", "version", "presets"],
  "properties": {
    "character_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,31}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "notes": { "type": "string" },
    "presets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rate", "emo", "pause_after"],
        "properties": {
          "rate": {
            "type": "number",
            "minimum": 0.7,
            "maximum": 1.3,
            "description": "库内语义:>1 更快。适配器负责转换(IndexTTS-2.5 需取倒数)"
          },
          "emo": {
            "type": "object",
            "propertyNames": {
              "enum": ["happy", "angry", "sad", "afraid", "disgusted", "melancholic", "surprised", "calm"]
            },
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
            "description": "具名情绪权重。各键之和须 ≤0.8(规则 L2-02,由脚本校验)"
          },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "pause_after": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.5,
            "description": "该 beat 后的静音秒数。全部 preset 不得同值(规则 L2-04)"
          },
          "gain_db": { "type": "number", "minimum": -12, "maximum": 6 },
          "reverb": { "enum": ["none", "close", "room_small", "room_large"] }
        }
      }
    }
  }
}
