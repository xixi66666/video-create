{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "voicelib/schema/qc-report.schema.json",
  "title": "Voice QC Report",
  "description": "模块的判定结果。逐规则给出结论,失败项必须带 module/errors.yaml 的 code。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "scene_id", "stage", "verdict", "checks", "summary"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "scene_id": { "type": "string", "pattern": "^S\\d{2,}$" },
    "stage": { "enum": ["draft", "final"] },
    "mode": { "enum": ["generate", "verify", "regenerate"] },
    "verdict": {
      "enum": ["pass", "conditional", "reject"],
      "description": "reject 时调用方必须停止,不得降级继续"
    },
    "generated_at": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "status"],
        "properties": {
          "rule": { "type": "string", "pattern": "^L[0-5]-\\d{2}$", "description": "rules.yaml 中的编号" },
          "code": { "type": "string", "pattern": "^[EW]\\d{4}$", "description": "module/errors.yaml 中的错误码;pass 时可省略" },
          "level": { "enum": ["block", "warn"] },
          "status": { "enum": ["pass", "fail", "skip", "pending_human"] },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "message": { "type": "string" },
          "artifact": { "type": "string", "description": "证据文件,如波形图/单句音频" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "enum": ["fail"] } }, "required": ["status"] },
            "then": { "required": ["code", "message"] }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "pending_human": { "type": "integer", "minimum": 0 },
        "blocked_by": { "type": "array", "items": { "type": "string" }, "description": "致 reject 的规则编号" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": { "type": "string" },
        "master": { "type": "string" },
        "subtitles": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "reject" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "summary": { "required": ["blocked_by"], "properties": { "blocked_by": { "minItems": 1 } } }
        }
      }
    }
  ]
}
