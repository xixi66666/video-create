{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "voicelib/schema/voice_card.schema.json",
  "title": "Voice Card",
  "description": "角色声卡。一个 character_id 一张,定义身份、音色、供应商映射与授权。",
  "type": "object",
  "additionalProperties": false,
  "required": ["character_id", "display_name", "version", "status", "profile", "voice", "source", "providers", "fallback_order"],
  "properties": {
    "character_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,31}$",
      "description": "全局唯一,永不复用。规则见 SPEC 附录 A"
    },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "改音色/参考音频升 MAJOR;改预设升 MINOR;改注释升 PATCH"
    },
    "status": { "enum": ["draft", "active", "retired"] },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gender", "age_range", "timbre_tags"],
      "properties": {
        "gender": { "enum": ["male", "female", "neutral"] },
        "age_range": { "type": "string", "pattern": "^\\d{1,2}-\\d{1,2}$" },
        "timbre_tags": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "maxLength": 8 },
          "description": "用于选角检索,2-6 个短标签"
        },
        "archetype": { "type": "string", "maxLength": 20 },
        "register": { "type": "string", "maxLength": 20, "description": "音区,如 中低音区" },
        "notes": { "type": "string" }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate_baseline"],
      "properties": {
        "rate_baseline": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.3,
          "description": "库内语义:>1 更快。<1 更慢。禁止填入供应商原生 speed"
        },
        "pitch_baseline_st": { "type": "number", "minimum": -12, "maximum": 12 },
        "breathiness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "license_ref"],
      "properties": {
        "type": {
          "enum": ["commissioned_cv", "self_recorded", "licensed_api", "designed", "harvested"],
          "description": "harvested = 从视频/音频采集;须记录来源,未签授权前仅可 draft"
        },
        "license_ref": {
          "type": "string",
          "pattern": "^licenses/.+\\.md$",
          "description": "相对 voicelib 根目录的授权文件。缺失即构建失败"
        },
        "valid_until": { "type": "string", "format": "date" },
        "refs": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "calm": { "$ref": "#/definitions/refPath" },
            "intense": { "$ref": "#/definitions/refPath" },
            "whisper": { "$ref": "#/definitions/refPath" }
          },
          "description": "参考干声,10-14 秒(硬上限 15 秒,超出会被上游静默截断),无 BGM 无混响。零样本克隆下决定音色质量;参考音频的语速语调会被一并克隆"
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "description": "key 为 providers.yaml 中登记的能力名。内部参数由适配器解释,不在此校验",
      "additionalProperties": { "type": "object" }
    },
    "fallback_order": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "必须都能在 providers 与 providers.yaml 中找到"
    },
    "bench": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lines": { "type": "string" },
        "last_score": { "type": ["number", "null"], "minimum": 0, "maximum": 5 }
      }
    },
    "notes": { "type": "string" }
  },
  "definitions": {
    "refPath": {
      "type": "string",
      "pattern": "^refs/.+\\.(wav|flac)$",
      "description": "仅接受无损格式;MP3 参考音频会污染克隆结果"
    }
  }
}
