{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://voicelib.local/schema/beats.schema.json",
  "title": "Performable Script (Beats)",
  "description": "可表演脚本。配音的输入单位,不是散文。对应 SPEC §3 与规则 L1-01~L1-06。",
  "type": "object",
  "additionalProperties": false,
  "required": ["scene_id", "beats"],
  "properties": {
    "scene_id": { "type": "string", "pattern": "^S\\d{2,}$", "description": "场景号,如 S01" },
    "pace_profile": {
      "enum": ["drama", "explainer"],
      "default": "drama",
      "description": "语速档。drama 3.2-3.8 字/秒,explainer 4.0-4.4(L0-04)"
    },
    "character_refs": {
      "type": "array",
      "description": "本场景用到的角色,须已在 registry.json 登记(铁律 3)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["character_id", "version"],
        "properties": {
          "character_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,31}$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
          "role": { "enum": ["lead", "support", "narrator", "cameo"] }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/beat" }
    }
  },
  "definitions": {
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "speaker", "text", "emotion", "pause_after"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S\\d{2,}-B\\d{2,}$",
          "description": "形如 S01-B03。一旦定稿不得改号,缓存与字幕都依赖它"
        },
        "speaker": {
          "type": "string",
          "description": "character_id,或 narrator"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "去标点须 ≤18 字(L1-02);含标点上限 40。数字须写成汉字(L1-03)"
        },
        "emotion": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "必须是该角色 presets.yaml 中已定义的键(L1-05)"
        },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "pause_after": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5,
          "description": "该 beat 后的静音秒数。全部 beat 不得同值(L2-04)"
        },
        "block": {
          "type": "string",
          "description": "合成块 id,同块共缓存。块内合计 ≤40 字(L1-06)。缺省则一句一块"
        },
        "notes": { "type": "string", "description": "表演提示,不进 TTS" }
      }
    }
  }
}
